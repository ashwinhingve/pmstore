{
  "name": "pmstore-mobile",
  "version": "1.0.0",
  "description": "PMStore Android app — Expo + React Native",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "build": "eas build --platform android",
    "build:preview": "eas build --platform android --profile preview",
    "submit": "eas submit --platform android"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~3.6.0",
    "expo-font": "~13.0.0",
    "expo-image": "~2.2.0",
    "expo-notifications": "~0.29.0",
    "expo-secure-store": "~13.0.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-screens": "~4.2.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-gesture-handler": "~2.20.0",
    "@tanstack/react-query": "^5.56.2",
    "zustand": "^4.5.5",
    "zod": "^3.24.1",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.76.0",
    "@types/react": "~18.3.0",
    "@types/react-native": "~0.76.0",
    "typescript": "~5.6.0",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.0",
    "@testing-library/react-native": "^12.4.4"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  }
