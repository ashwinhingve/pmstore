# Release signing config for the PM Store Android app.
#
# HOW TO USE
#   1. Generate the upload keystore ONCE (keep it OUTSIDE the repo, back it up):
#        keytool -genkeypair -v -keystore pmstore-upload.keystore \
#          -alias pmstore -keyalg RSA -keysize 2048 -validity 10000
#   2. Copy this file to `keystore.properties` (same folder) and fill in the
#      real values below. `keystore.properties` is gitignored — never commit it.
#   3. Build the release bundle:  cd mobile/android && ./gradlew.bat bundleRelease
#
# See docs/10-ANDROID-RELEASE.md §5 for the full walkthrough.
#
# storeFile: absolute path is safest. A relative path resolves from mobile/android/app/.
storeFile=C:/Users/<you>/keys/pmstore-upload.keystore
storePassword=<keystore password>
keyAlias=pmstore
keyPassword=<key password>
