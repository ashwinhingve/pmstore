# Mobile app runtime config. Copy to mobile/.env.local and fill in.
# EXPO_PUBLIC_* values are embedded into the build (not secret-safe) — only put
# public identifiers here, never API secrets.

# Backend API base — no trailing slash, no /api/v1 (the client appends it).
# Point at your deployed site, or your PC's LAN IP while running the web dev
# server (e.g. http://192.168.1.20:3000). localhost does NOT work from a phone.
EXPO_PUBLIC_API_URL=https://pratigyamedicalstore.com

# Cloudinary — for direct (unsigned) prescription-image upload from the device.
# Create an UNSIGNED upload preset in the Cloudinary dashboard restricted to the
# pmstore/prescriptions folder, then put its name here.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Cashfree mode for the in-app checkout WebView. MUST match the server's
# CASHFREE_ENV (sandbox for testing, production for live).
EXPO_PUBLIC_CASHFREE_MODE=sandbox
