# nodemailer@9 (security patch) vs @auth/core's optional nodemailer@^7 peer trips
# npm's strict peer resolver on Vercel's `npm install`. The lockfile already pins
# a working tree (nodemailer@9, used via Brevo SMTP — not @auth/core's mailer), so
# relax peer resolution to match the local install. Changes no installed versions.
legacy-peer-deps=true
