# ==========================================
# Pratigya Medical Store — Environment Variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ==========================================

# ------------------------------------------
# CORE
# ------------------------------------------

# MongoDB Atlas connection string (free M0 tier is fine for launch).
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/pmstore
# NOTE: search uses an Atlas Search index configured in the Atlas UI
# (see docs/05-SETUP.md) — there is no separate search API key.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/pmstore

# NextAuth (web session auth)
# NEXTAUTH_URL: http://localhost:3000 in dev, https://pratigyamedicalstore.com in prod
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32  (use a fresh value in production)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Public URLs — set both to your domain in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS allow-list for the API (comma-separated origins). See middleware.ts.
# Prod example: https://pratigyamedicalstore.com,https://www.pratigyamedicalstore.com
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for internal server-to-server API calls (shipment queue, etc.)
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=generate-with-openssl-rand-hex-32

# development | production | test
NODE_ENV=development

# ------------------------------------------
# GOOGLE OAUTH (Google sign-in)
# ------------------------------------------
# https://console.cloud.google.com/ → OAuth 2.0 credentials.
# Authorized redirect URI (dev): http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://pratigyamedicalstore.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------
# ADMIN
# ------------------------------------------
# Email that scripts/bootstrap-admin.ts promotes to the admin role.
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# Where admin/order/contact-form notification emails are sent.
ADMIN_EMAIL=pawan8133@gmail.com

# ------------------------------------------
# PAYMENTS — CASHFREE
# ------------------------------------------
# https://merchant.cashfree.com/ → Developers → API Keys.
# (This project uses Cashfree; there is no Razorpay integration in code.)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# sandbox | production
CASHFREE_ENV=sandbox
# Where Cashfree redirects after payment
# Dev: http://localhost:3000/api/payment/callback
# Prod: https://pratigyamedicalstore.com/api/payment/callback
CASHFREE_RETURN_URL=http://localhost:3000/api/payment/callback

# ------------------------------------------
# IMAGES — CLOUDINARY (product + prescription images), free tier
# ------------------------------------------
# https://cloudinary.com/ → Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------
# EMAIL — SMTP (order + refill emails)
# ------------------------------------------
# Brevo recommended (free tier, https://www.brevo.com/ → SMTP & API).
# Gmail also works: enable 2FA, create an app password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
# App/relay password (SMTP_PASS and SMTP_PASSWORD are both accepted)
SMTP_PASS=your-smtp-password
# Sender shown in the inbox (SMTP_FROM and EMAIL_FROM are both accepted)
SMTP_FROM=Pratigya Medical Store <no-reply@pratigyamedicalstore.com>

# ------------------------------------------
# ADMIN ALERTS — TELEGRAM (free; used for order/stock alerts)
# ------------------------------------------
# Create a bot via @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Optional: admin phone shown in some alert links
ADMIN_PHONE=+919755550126

# ------------------------------------------
# MOBILE APP (/api/v1 bearer auth)
# ------------------------------------------
# Signs mobile access/refresh tokens. MUST differ from NEXTAUTH_SECRET.
# Generate: openssl rand -base64 32
MOBILE_JWT_SECRET=generate-a-different-secret-from-nextauth

# ------------------------------------------
# CRON (refill reminders)
# ------------------------------------------
# Shared bearer token for the scheduled refill-reminder job.
# Must match the CRON_SECRET GitHub Actions secret (.github/workflows/cron.yml).
# Generate: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# ------------------------------------------
# MONITORING (optional)
# ------------------------------------------
# Sentry error tracking (free tier). Leave blank to disable.
SENTRY_DSN=
# debug | info | warn | error
LOG_LEVEL=info

# ==========================================
# DEFERRED — present in code but NOT needed for launch (scope-guarded)
# ==========================================
# Courier API integration (Delhivery / Shiprocket) is deferred — manual
# courier status updates are used at current order volume. SMS OTP is
# deferred (needs DLT registration). Leave the block below unset unless/
# until you deliberately turn these on.
#
# DELHIVERY_API_KEY=
# DELHIVERY_BASE_URL=https://track.delhivery.com
# DELHIVERY_RETURN_PINCODE=462041
# DELHIVERY_RETURN_ADDRESS=
# DELHIVERY_RETURN_CITY=Bhopal
# DELHIVERY_RETURN_STATE=Madhya Pradesh
# DELHIVERY_RETURN_COUNTRY=India
# DELHIVERY_RETURN_NAME=Pratigya Medical Store
# DELHIVERY_RETURN_PHONE=9755550126
# DELHIVERY_WEBHOOK_SECRET=
#
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_WEBHOOK_SECRET=
# WAREHOUSE_PINCODE=462041

# ==========================================
# PRODUCTION CHECKLIST
# ==========================================
# [ ] Fresh NEXTAUTH_SECRET, MOBILE_JWT_SECRET, CRON_SECRET, INTERNAL_API_SECRET
# [ ] NEXTAUTH_URL / NEXT_PUBLIC_* set to the real domain
# [ ] Google OAuth prod redirect URI added
# [ ] CASHFREE_ENV=production + prod keys; callback URL on the real domain
# [ ] Production SMTP credentials (Brevo)
# [ ] Atlas Search index created (see docs/05-SETUP.md)
# [ ] NODE_ENV=production, HTTPS, DB backups, rate limiting reviewed
