# ==========================================
# Tapti Spices E-Commerce Platform
# Environment Variables Configuration
# ==========================================

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# MongoDB Connection URI
# Local: mongodb://localhost:27017/tapti-spices
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/tapti-spices
MONGODB_URI=mongodb://localhost:27017/tapti-spices

# ==========================================
# NEXTAUTH CONFIGURATION
# ==========================================

# NextAuth URL (your application URL)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret (REQUIRED - Generate with: openssl rand -base64 32)
# This should be a random string. Generate a new one for production!
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# ==========================================
# GOOGLE OAUTH CONFIGURATION
# ==========================================

# Get these from: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    Production: https://yourdomain.com/api/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# CASHFREE PAYMENT GATEWAY
# ==========================================

# Get credentials from: https://merchant.cashfree.com/
# 1. Sign up / login at Cashfree Merchant Dashboard
# 2. Go to Developers > API Keys
# 3. Copy App ID and Secret Key

CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Environment: sandbox or production
CASHFREE_ENV=sandbox

# Return URL (where Cashfree redirects after payment)
# Development: http://localhost:3000/api/payment/callback
# Production: https://yourdomain.com/api/payment/callback
CASHFREE_RETURN_URL=http://localhost:3000/api/payment/callback

# ==========================================
# DELHIVERY SHIPPING API
# ==========================================

# Get API key from: https://www.delhivery.com/
# Contact Delhivery support for staging/production credentials

# API Configuration
DELHIVERY_API_KEY=your_delhivery_api_key

# API Base URL
# Production: https://one.delhivery.com (CURRENTLY USING PRODUCTION)
# Note: Staging was https://staging-express.delhivery.com
DELHIVERY_BASE_URL=https://one.delhivery.com

# Warehouse/Return Address Details
DELHIVERY_RETURN_PINCODE=400001
DELHIVERY_RETURN_ADDRESS=Your Warehouse Address, Area Name, Landmark
DELHIVERY_RETURN_CITY=Mumbai
DELHIVERY_RETURN_STATE=Maharashtra
DELHIVERY_RETURN_COUNTRY=India
DELHIVERY_RETURN_NAME=Tapti Spices
DELHIVERY_RETURN_PHONE=9876543210

# Webhook Secret (generate a random secure string)
# Generate with: openssl rand -hex 32
DELHIVERY_WEBHOOK_SECRET=your-random-secure-webhook-secret-string

# ==========================================
# EMAIL NOTIFICATIONS (SMTP)
# ==========================================

# Gmail Configuration (recommended for development)
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# From Email Address (shown in recipient's inbox)
EMAIL_FROM=Tapti Spices <noreply@taptispices.com>

# Alternative SMTP Providers:
# SendGrid: smtp.sendgrid.net (Port: 587)
# Mailgun: smtp.mailgun.org (Port: 587)
# Amazon SES: email-smtp.region.amazonaws.com (Port: 587)

# ==========================================
# SMS NOTIFICATIONS (TWILIO)
# ==========================================

# Get credentials from: https://www.twilio.com/
# 1. Sign up for Twilio account
# 2. Get a phone number
# 3. Find Account SID and Auth Token in dashboard

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Alternative SMS Providers:
# MSG91: Use MSG91 API
# AWS SNS: Use AWS SNS API
# Firebase: Use Firebase Cloud Messaging

# ==========================================
# WHATSAPP ADMIN NOTIFICATIONS (TWILIO)
# ==========================================
#
# Uses your existing Twilio account — no extra package needed.
#
# SANDBOX (free testing):
#   1. Go to https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
#   2. Note the sandbox join keyword (e.g. "join silver-tiger")
#   3. From YOUR WhatsApp (+91 93292 16544), send that join message to +1 415 523 8886
#   4. Set TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# PRODUCTION (your own WhatsApp Business number on Twilio):
#   1. Register a WhatsApp-enabled number in Twilio console
#   2. Set TWILIO_WHATSAPP_FROM=whatsapp:+91XXXXXXXXXX
#
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=+919329216544

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Public Application URL
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
# development | production | test
NODE_ENV=development

# ==========================================
# OPTIONAL: ADDITIONAL SERVICES
# ==========================================

# Analytics (Google Analytics, Mixpanel, etc.)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Error Tracking (Sentry)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# CDN for Images (Cloudinary, AWS S3, etc.)
# NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# ==========================================
# PRODUCTION CHECKLIST
# ==========================================
# Before deploying to production:
#
# [ ] Generate new NEXTAUTH_SECRET
# [ ] Update NEXTAUTH_URL to production domain
# [ ] Add production domain to Google OAuth authorized redirects
# [ ] Switch CASHFREE_ENV to production
# [✓] Switch Delhivery to production URL (already set to one.delhivery.com)
# [ ] Update all callback/webhook URLs to production domain
# [ ] Use production SMTP credentials
# [ ] Use production Twilio credentials
# [ ] Set NODE_ENV=production
# [ ] Test complete flow in production
# [ ] Set up monitoring and error tracking
# [ ] Configure SSL/HTTPS
# [ ] Set up database backups
# [ ] Review security headers
# [ ] Enable rate limiting
# [ ] Set up CDN for static assets
#
# ==========================================
