# PMStore — free-tier stack. See PMStore-Build-Plan.md §2.

# --- Database: MongoDB Atlas M0 (free, 512MB, Atlas Search included) ---
MONGODB_URI=
ATLAS_SEARCH_INDEX=products_search

# --- Auth: NextAuth ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://pratigyamedicalstore.com
# Public site URL — metadata, emails, canonical. On Vercel set to the deploy URL.
NEXT_PUBLIC_SITE_URL=https://pratigyamedicalstore.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web client ID exposed to the browser so the Capacitor app's native Google
# sign-in can request an idToken (same value as GOOGLE_CLIENT_ID — the ID is not
# a secret). GOOGLE_ANDROID_CLIENT_ID is optional (extra allowed idToken audience).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Email: Brevo SMTP, 300/day free ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PMStore <orders@pratigyamedicalstore.com>"

# --- Images: Cloudinary free tier ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments: Cashfree (the implemented gateway) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox                 # sandbox | production
CASHFREE_RETURN_URL=https://pratigyamedicalstore.com/api/payment/callback

# --- Shipping: Delhivery (courier). Local pincode 462041 is hand-delivered. ---
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_RETURN_PINCODE=462041
DELHIVERY_RETURN_ADDRESS=S 2 Vikash Kunj
DELHIVERY_RETURN_CITY=Bhopal
DELHIVERY_RETURN_STATE=Madhya Pradesh
DELHIVERY_RETURN_NAME=Pratigya Medical Store
DELHIVERY_RETURN_PHONE=+919755550126
DELHIVERY_RETURN_COUNTRY=India
DELHIVERY_WEBHOOK_SECRET=
WAREHOUSE_PINCODE=462041
# Separate from DELHIVERY_WEBHOOK_SECRET so a leaked poll-cron trigger can't
# also be used to forge Delhivery webhook signatures. Falls back to
# DELHIVERY_WEBHOOK_SECRET if unset.
SHIPPING_POLL_SECRET=

# --- Shipping: Shiprocket (alternate courier provider, optional) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_DEFAULT_LENGTH=15
SHIPROCKET_DEFAULT_BREADTH=12
SHIPROCKET_DEFAULT_HEIGHT=10
# Shared secret with the Shiprocket dashboard webhook config (Settings > Webhooks > Token)
SHIPROCKET_WEBHOOK_SECRET=

# --- Internal service-to-service calls (e.g. shipment queue -> /api/shipping/*) ---
INTERNAL_API_SECRET=

# --- SMS / OTP: Fast2SMS (mobile-number OTP login + order SMS) ---
FAST2SMS_API_KEY=
ADMIN_PHONE=                     # receives admin order/shipment SMS alerts

# --- Push: Firebase Cloud Messaging (free) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- WhatsApp auto-reply bot: Meta Cloud API (free for inbound replies) ---
# All four from the Meta app dashboard (developers.facebook.com). The bot only
# replies to inbound messages (free 24h service window), so messaging cost is ~₹0.
WHATSAPP_VERIFY_TOKEN=            # any secret string you choose; also entered in the Meta webhook config
WHATSAPP_APP_SECRET=             # Meta app > Settings > Basic (verifies webhook signatures)
WHATSAPP_ACCESS_TOKEN=          # permanent token from a Meta system user
WHATSAPP_PHONE_NUMBER_ID=       # WhatsApp > API setup
# WHATSAPP_GRAPH_VERSION=v21.0  # optional; set to the version your dashboard shows if the default is deprecated

# --- Monitoring: Sentry free tier ---
SENTRY_DSN=
LOG_LEVEL=                        # DEBUG | INFO | WARN | ERROR (defaults to INFO)

# --- Admin alerts via Telegram (optional; whatsapp.ts is actually a Telegram bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Security ---
ALLOWED_ORIGINS=https://pratigyamedicalstore.com,https://www.pratigyamedicalstore.com
ADMIN_BOOTSTRAP_EMAIL=            # seeds the first admin, then delete this
# Bearer secret for the daily refill-reminders cron (.github/workflows/cron.yml)
CRON_SECRET=
# Public site URL used in email/SMS deep links (orders, tracking, retry-payment)
NEXT_PUBLIC_APP_URL=https://pratigyamedicalstore.com
# Overrides the contact-form/wholesale notification recipient (defaults to MAIL_FROM's address)
WHOLESALE_ENQUIRY_EMAIL=

# --- Deferred: SMS needs DLT registration, not in v1 ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
